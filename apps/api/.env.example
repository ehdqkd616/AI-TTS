# 서버 — 기본은 루프백 전용(127.0.0.1). 외부 접근은 Caddy를 통해서만
PORT=3001
HOST=127.0.0.1
# 입력 글자 수 제한
MAX_TEXT_LENGTH=5000
# 남용·비용 보호
# /api/tts 분당 요청 수 (회원별), 감지·미리보기 분당 요청 수
RATE_LIMIT_PER_MIN=10
LIGHT_RATE_LIMIT_PER_MIN=120
# 엔진을 실제로 호출한 글자 수 기준 일일 한도 (캐시 적중은 미차감, 자정(서버 시간) 초기화)
# 회원별 기본값 — 관리자 페이지에서 회원마다 조정 가능, 관리자 계정은 회원별 한도 없음
DAILY_CHAR_LIMIT_PER_USER=20000
DAILY_CHAR_LIMIT_GLOBAL=200000
# 동시 합성 작업 수 (초과 시 503)
MAX_CONCURRENT_JOBS=3

# 캐시·이력 저장 위치 (기본: apps/api/storage)
STORAGE_DIR=

# 상용 API 키 — 설정된 엔진만 활성화됩니다. 절대 프론트엔드에 넣지 마세요.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google: REST API 키 방식 (서비스 계정을 쓰려면 GoogleProvider를 확장)
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# 오픈소스 모델 서버 (2단계 이후, POST /synthesize 계약은 README 참고)
MODEL_SERVER_URL=

# 개발용 테스트 톤 엔진: auto(다른 엔진이 하나도 없을 때만) | true | false
TTS_MOCK=auto

# 회원·세션
SESSION_DAYS=7
# IP별 시간당 가입 신청 수
SIGNUP_LIMIT_PER_HOUR=10
# 공통 관리자 계정 admin의 비밀번호 — 서버가 시작할 때마다 이 값으로 만들거나 맞춘다(.env가 기준)
ADMIN_PASSWORD=

# 회원가입 승인 요청 메일 (Gmail은 2단계 인증 + 앱 비밀번호). 비워 두면 발송 안 함
PUBLIC_WEB_URL=http://localhost:5173
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
