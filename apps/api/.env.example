# 서버 — 기본은 루프백 전용(127.0.0.1). 외부 접근은 Caddy를 통해서만
PORT=3001
HOST=127.0.0.1
# 입력 글자 수 제한
MAX_TEXT_LENGTH=5000
# 남용·비용 보호
# /api/tts 분당 요청 수 (회원별), 감지·미리보기 분당 요청 수
RATE_LIMIT_PER_MIN=10
LIGHT_RATE_LIMIT_PER_MIN=120
# 엔진을 실제로 호출한 글자 수 기준 일일 한도 (캐시 적중은 미차감, 자정(서버 시간) 초기화)
# 회원별 기본값 — 관리자 페이지에서 회원마다 조정 가능, 관리자 계정은 회원별 한도 없음
DAILY_CHAR_LIMIT_PER_USER=20000
DAILY_CHAR_LIMIT_GLOBAL=200000
# 상용 엔진(Google·Azure 등)별 일일 한도 — 무료 사용량을 넘어 자동 결제되지 않게. 넘으면 그날은 무료 모델로 전환
PAID_ENGINE_DAILY_CHAR_LIMIT=30000
# 상용 엔진별 월 한도 (무료 월 100만 자보다 10% 낮게). 코드에서 95만 자를 넘지 못하게 고정됨
PAID_ENGINE_MONTHLY_CHAR_LIMIT=900000
# 동시 합성 작업 수 (초과 시 503)
MAX_CONCURRENT_JOBS=3

# 캐시·이력 저장 위치 (기본: apps/api/storage)
STORAGE_DIR=

# 상용 API 키 — 설정된 엔진만 활성화됩니다. 절대 프론트엔드에 넣지 마세요.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Google: REST API 키 방식 (서비스 계정을 쓰려면 GoogleProvider를 확장)
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# 오픈소스 모델 서버 (2단계 이후, POST /synthesize 계약은 README 참고)
MODEL_SERVER_URL=

# 목소리 변환(RVC) — 관리자가 올린 목소리 모델로 TTS 결과를 바꾼다. RVC_ROOT를 비우면 기능이 꺼진다.
# RVC_ROOT: RVC-Learning의 RVC WebUI 폴더 (infer/cli.py가 있는 곳), 그 안의 .venv 파이썬을 그대로 쓴다
RVC_ROOT=
# 다른 파이썬을 쓰려면 지정 (기본: $RVC_ROOT/.venv/bin/python)
RVC_PYTHON=
# 변환 한 건 최대 시간(초), 대기열 길이(GPU 하나라 한 번에 하나씩 처리, 초과 시 503)
RVC_TIMEOUT_SEC=300
RVC_MAX_QUEUE=3
# 음높이 추출 rmvpe(품질) | pm(빠름), index 반영 비율 0~1, 자음 보호 0~0.5 — 모델마다 관리자 화면에서 따로 정할 수 있고, 비우면 이 값
RVC_F0_METHOD=rmvpe
RVC_INDEX_RATE=0.75
RVC_PROTECT=0.33
# 업로드 크기 한도(MB) — Caddy 설정의 voice-models 본문 한도와 맞출 것
VOICE_MODEL_MAX_MB=300
VOICE_INDEX_MAX_MB=1024

# 목소리 학습(관리자 → 목소리 학습) — 낭독 녹음으로 RVC 모델을 학습. RVC_ROOT의 train/ 스크립트를 쓴다
# 배치 크기(GTX 1050 Ti 4GB는 1 — 2부터 GPU 메모리 부족), 체크포인트 저장 간격(에포크, 중단 후 이어서 학습하는 지점), 전처리에 쓸 CPU 수
RVC_TRAIN_BATCH_SIZE=1
RVC_TRAIN_SAVE_EVERY=5
RVC_TRAIN_CPUS=4
# 학습으로 등록하는 모델의 index 비율(발음 우선으로 낮게 — README '발음' 참고). 등록 뒤 관리자 화면에서 모델마다 바꿀 수 있다
RVC_TRAIN_INDEX_RATE=0.3
# 시작 전 여유 메모리 검사(MB, 0이면 안 함) — 모자라면 시작하지 않고 실패로 표시
RVC_TRAIN_MIN_FREE_MB=2500
RVC_TRAIN_MIN_GPU_FREE_MB=3000
# 녹음 길이 한도(초)와 파일 하나 크기(MB) — Caddy 설정의 voice-trainings 본문 한도와 맞출 것
VOICE_TRAIN_MIN_SEC=180
VOICE_TRAIN_MAX_SEC=7200
VOICE_TRAIN_FILE_MAX_MB=500

# 개발용 테스트 톤 엔진: auto(다른 엔진이 하나도 없을 때만) | true | false
TTS_MOCK=auto

# 회원·세션
SESSION_DAYS=7
# IP별 시간당 가입 신청 수
SIGNUP_LIMIT_PER_HOUR=10
# 공통 관리자 계정 admin의 비밀번호 — 서버가 시작할 때마다 이 값으로 만들거나 맞춘다(.env가 기준)
ADMIN_PASSWORD=

# 회원가입 승인 요청 메일 (Gmail은 2단계 인증 + 앱 비밀번호). 비워 두면 발송 안 함
PUBLIC_WEB_URL=http://localhost:5173
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 서버 내부 API (다른 프로젝트가 127.0.0.1로 직접 호출) — 이름:토큰 목록, 토큰은 openssl rand -hex 32 (32자 이상)
# 예: INTERNAL_API_TOKENS=shorts:<토큰>   비우면 내부 API 꺼짐
INTERNAL_API_TOKENS=
# 서비스 계정별 하루 글자 수 한도
INTERNAL_DAILY_CHAR_LIMIT=30000
