# /etc/caddy/Caddyfile 에 추가 (Caddy가 HTTPS 인증서 자동 발급)
ai-tts.hotgarlic.dedyn.io {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# 관리자 목소리 모델 업로드(.pth 최대 300MB, .index 최대 1GB)만 큰 본문 허용 — 앱이 관리자 여부·크기를 다시 검사
	handle /api/admin/voice-models* {
		request_body {
			max_size 1100MB
		}
		reverse_proxy 127.0.0.1:3300
	}
	# 그 밖의 API 요청 본문은 텍스트 JSON뿐 (앱 한도 256KB보다 약간 여유)
	handle {
		request_body {
			max_size 512KB
		}
		reverse_proxy 127.0.0.1:3300
	}
}

